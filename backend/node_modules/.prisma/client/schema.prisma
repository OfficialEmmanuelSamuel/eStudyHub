generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ExamType {
  GENERAL
  WAEC
  JAMB
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  STARTED
  COMPLETED
  ABANDONED
}

model User {
  id                String             @id @default(cuid())
  firebaseUid       String             @unique
  email             String             @unique
  fullName          String?
  username          String?            @unique
  photoUrl          String?
  role              UserRole           @default(STUDENT)
  level             Int                @default(1)
  xpPoints          Int                @default(0)
  streakDays        Int                @default(0)
  timezone          String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  profile           UserProfile?
  subjectPrefs      UserSubject[]
  quizAttempts      QuizAttempt[]
  studySessions     StudySession[]
  plannerTasks      StudyPlannerTask[]
  communityMessages CommunityMessage[]
  notifications     Notification[]
  progressRecords   ProgressRecord[]
}

model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  department     String?
  classLevel     String?
  bio            String?
  school         String?
  state          String?
  country        String?
  targetExam     ExamType?
  subjectFocus   String?
  dailyStudyGoal Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id          String         @id @default(cuid())
  name        String         @unique
  department  String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  topics      SubjectTopic[]
  quizzes     SubjectQuiz[]
  examPapers  ExamPaper[]
  followers   UserSubject[]
}

model UserSubject {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model StudentSubject {
  id          String   @id @default(cuid())
  firebaseUid String
  department  String
  category    String
  name        String
  createdAt   DateTime @default(now())

  @@unique([firebaseUid, name])
}

model SubjectTopic {
  id          String        @id @default(cuid())
  subjectId   String
  title       String
  description String?
  content     String?
  imageUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quizzes     SubjectQuiz[]

  @@unique([subjectId, title])
}

model SubjectQuiz {
  id           String         @id @default(cuid())
  subjectId    String
  topicId      String?
  examType     ExamType       @default(GENERAL)
  difficulty   QuizDifficulty @default(MEDIUM)
  question     String
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  answer       String
  explanation  String?
  timeLimitSec Int?
  points       Int            @default(10)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic        SubjectTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts     QuizAttempt[]
  paperId      String?
  paper        ExamPaper?     @relation(fields: [paperId], references: [id], onDelete: SetNull)
}

model Question {
  id          String @id @default(cuid())
  subject     String
  year        Int
  question    String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  answer      String
  explanation String
}

model ExamPaper {
  id           String        @id @default(cuid())
  title        String
  examType     ExamType
  year         Int
  subjectId    String
  durationMins Int?
  instructions String?
  isPublished  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions    SubjectQuiz[]

  @@unique([examType, year, subjectId, title])
  @@index([examType, year])
}

model QuizAttempt {
  id             String        @id @default(cuid())
  userId         String
  quizId         String
  selectedAnswer String?
  isCorrect      Boolean?
  score          Int           @default(0)
  status         AttemptStatus @default(STARTED)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           SubjectQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
}

model ProgressRecord {
  id             String   @id @default(cuid())
  userId         String
  subjectId      String?
  topicId        String?
  completionRate Float    @default(0)
  averageScore   Float    @default(0)
  quizzesTaken   Int      @default(0)
  totalStudyMins Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subjectId])
}

model StudySession {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String?
  topicId      String?
  durationMins Int
  notes        String?
  studiedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, studiedAt])
}

model StudyPlannerTask {
  id           String   @id @default(cuid())
  userId       String
  subject      String
  topic        String
  dueDate      DateTime
  durationMins Int      @default(60)
  priority     String   @default("Medium")
  isCompleted  Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, isCompleted])
}

model CommunityMessage {
  id        String   @id @default(cuid())
  userId    String
  text      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  title        String
  message      String
  isRead       Boolean   @default(false)
  metadataJson Json?
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WebsiteSetting {
  id                String   @id @default(cuid())
  siteName          String   @default("eStudyHub")
  supportEmail      String?
  brandLogoUrl      String?
  maintenanceMode   Boolean  @default(false)
  allowRegistration Boolean  @default(true)
  defaultTimezone   String   @default("Africa/Lagos")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  detailsJson Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
